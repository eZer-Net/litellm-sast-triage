# LiteLLM OpenAI-compatible endpoint (without /chat/completions)
AI_BASE_URL=https://llm.example.com/v1/chat/completions
AI_API_KEY=YOUR_API_KEY
AI_MODEL=your-model-id
# json is portable; native needs provider function-calling compatibility
AI_PROTOCOL=json
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_SECONDS=3
# Pause between API requests, in seconds
AI_REQUEST_PAUSE_SECONDS=2
# Pause between alerts, in seconds
ALERT_PAUSE_SECONDS=60
# Project directory (absolute path or path relative to shell current directory).
# Leave empty to be prompted in an interactive terminal; pass --project for CI.
PROJECT_DIR=
# Filename or relative path inside PROJECT_DIR. Override with --scan.
SCAN_FILE=scan-all.json
# Prefix for timestamped output files (dd.mm.yyyy-HH-MM-SS); --resultName replaces it
RESULT_NAME=triage-result-ai
PROMPT_FILE=prompt.txt
# Number of additional evidence-gathering steps
TAINT_DEPTH=5
# Maximum size of file returned in one read at line 1 (prefer full file to tiny overlapping windows)
MAX_WHOLE_FILE_LINES=350
# Initial and tool block selection: smart | window | symbol
CONTEXT_MODE=smart
CONTEXT_BEFORE=12
CONTEXT_AFTER=12
MAX_SYMBOL_LINES=120
MAX_BLOCK_LINES=200
MAX_FIND_MATCHES=30
MAX_FIND_BLOCKS=4
MAX_TOOL_ERRORS=4
MAX_PROTOCOL_ERRORS=4
MAX_TOTAL_TURNS=25

# One JSON event per line: the exact context sent, model reply, parse success/error, tool results
# WARNING: traces may contain proprietary source code. Keep output/ private.
TRACE_ENABLED=true
TRACE_INCLUDE_CONTENT=true
TRACE_MAX_CHARS=100000
